PORT=4000
HOST=127.0.0.1

# MongoDB connection string. Required when NODE_ENV=production.
# Atlas (free M0): create a database user, allow your IP under Network Access, then:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resaleanything
# Local default if unset:
# MONGODB_URI=mongodb://127.0.0.1:27017/resaleanything

# Browser origin(s) allowed to make state-changing requests, comma separated
APP_ORIGIN=http://localhost:3000
# Photo uploads directory
# DATA_DIR=./data
# Set to 1 to allow the session cookie over plain HTTP in production (e.g. local testing)
# INSECURE_COOKIES=1
# AUTH_RATE_MAX=10
